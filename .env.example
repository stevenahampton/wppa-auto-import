# Defaults shown below match the original deployment. Export only what differs.
WPPA_WP_ROOT=/var/www/wordpress
WPPA_SOURCE_ROOT=/mnt/1tb/onedrive/Pictures/Albums
WPPA_PARENT_ALBUM_ID=12
WPPA_PARENT_ALBUM_NAME=Photo Albums 2015 onwards
WPPA_OWNER=wordpress-user-login
WPPA_CHROME_PATH=/usr/bin/google-chrome

# Status given to albums created by an import run.
WPPA_NEW_ALBUM_STATUS=publish
# Status given to albums created by the nightly incremental import.
WPPA_NIGHTLY_NEW_ALBUM_STATUS=hidden
# Nightly import bookkeeping.
WPPA_NIGHTLY_STATE=/opt/wppa-auto-import/nightly-import.state.json
WPPA_NIGHTLY_LOCK=/opt/wppa-auto-import/nightly-import.lock

# Database values are normally read from WP_ROOT/wp-config.php.
# WPPA_DB_HOST=localhost
# WPPA_DB_NAME=wordpress
# WPPA_DB_USER=wordpress
# WPPA_DB_PASSWORD=secret
# WPPA_TABLE_PREFIX=wp_
