[Unit]
Description=Import new OneDrive album media into WPPA
After=rclone-backup.service network-online.target
ConditionPathIsDirectory=/mnt/1tb/onedrive/Pictures/Albums

[Service]
Type=oneshot
User=steven
Group=steven
WorkingDirectory=/var/www/wordpress
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/opt/wppa-auto-import/.env
ExecStart=/usr/bin/python3 /opt/wppa-auto-import/nightly-import-new-media.py
TimeoutStartSec=6h
Nice=10
IOSchedulingClass=idle
